# infra/postgres/.env.ha — فقط الگو؛ فایلِ واقعی را بسازید (0600، gitignored)
# docker compose -f infra/postgres/docker-compose.ha.yml --env-file infra/postgres/.env.ha up -d
PGHA_SUPERUSER=postgres
PGHA_PASSWORD=
PGHA_REPLICATION_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
PGHA_S3_KEY=
PGHA_S3_SECRET=
PB_REPO_S3_ENDPOINT=minio:9000
PB_REPO_S3_BUCKET=payesh-pgbackrest
PB_REPO_S3_REGION=us-east-1
PB_REPO_S3_VERIFY_TLS=n
# stream | repo (bootstrapِ standby از فضای شیئی وقتی شبکهٔ replication تازه است)
STANDBY_BOOTSTRAP=stream
