{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::payesh-backups",
        "arn:aws:s3:::payesh-backups/*"
      ],
      "Condition": {
        "Bool": { "aws:SecureTransport": "false" }
      }
    },
    {
      "Sid": "DenyPublicReads",
      "Effect": "Deny",
      "Principal": { "AWS": "*" },
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::payesh-backups",
        "arn:aws:s3:::payesh-backups/*"
      ],
      "Condition": {
        "StringNotEquals": { "aws:PrincipalType": "Service" }
      }
    },
    {
      "Sid": "RequireServerSideEncryption",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::payesh-backups/*",
      "Condition": {
        "StringNotEquals": { "s3:x-amz-server-side-encryption": "AES256" }
      }
    }
  ]
}
