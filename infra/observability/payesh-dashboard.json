{
  "__inputs": [],
  "__requires": [{ "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" }],
  "annotations": { "list": [] },
  "description": "Wave 14 (Observability) — payesh server. Panels read only metrics emitted by server/metrics.js.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["payesh", "wave14", "observability"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "timezone": "browser",
  "title": "Payesh — Observability (Wave 14)",
  "uid": "payesh-wave14",
  "version": 1,
  "panels": [
    {
      "type": "row",
      "title": "Overview — RED",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Requests / s",
      "id": 1,
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(payesh_http_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "5xx ratio",
      "id": 2,
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(payesh_http_requests_total{code=~\"5..\"}[5m])) / clamp_min(sum(rate(payesh_http_requests_total[5m])), 1e-9)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "id": 3,
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(payesh_http_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Event-loop lag",
      "id": 4,
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "max(payesh_node_eventloop_lag_seconds)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Cache hit rate",
      "id": 5,
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(payesh_cache_lookups_total{outcome=\"hit\"}[15m])) / clamp_min(sum(rate(payesh_cache_lookups_total[15m])), 1e-9)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.6 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Outbox backlog",
      "id": 6,
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "max(payesh_outbox_depth{status=\"pending\"})", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by status class",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (code) (rate(payesh_http_requests_total[5m]))", "legendFormat": "{{code}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles (p50 / p95 / p99)",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(payesh_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(payesh_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(payesh_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "p95 latency by route (top 10)",
      "id": 9,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(payesh_http_request_duration_seconds_bucket[5m]))))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Database",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 200,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "SQL p95 by op / target",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, op, target) (rate(payesh_db_query_duration_seconds_bucket[5m])))",
          "legendFormat": "{{op}}/{{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Pool connections and waiters",
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (pool, state) (payesh_db_pool_connections)",
          "legendFormat": "{{pool}}-{{state}}",
          "refId": "A"
        },
        { "expr": "sum by (pool) (payesh_db_pool_waiting)", "legendFormat": "{{pool}}-waiting", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "SQL errors and slow queries",
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (op, target) (rate(payesh_db_query_errors_total[5m]))",
          "legendFormat": "err {{op}}/{{target}}",
          "refId": "A"
        },
        {
          "expr": "sum by (op, target) (rate(payesh_db_slow_queries_total[5m]))",
          "legendFormat": "slow {{op}}/{{target}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Cache, sync and queue",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "id": 300,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Cache lookups by layer / outcome",
      "id": 13,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (layer, outcome) (rate(payesh_cache_lookups_total[5m]))",
          "legendFormat": "{{layer}}/{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Sync batch size (offline queue drain) and conflicts",
      "id": 14,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(payesh_sync_batch_ops_sum[5m])) / clamp_min(sum(rate(payesh_sync_batch_ops_count[5m])), 1e-9)",
          "legendFormat": "avg ops per push",
          "refId": "A"
        },
        {
          "expr": "sum(rate(payesh_sync_conflicts_total[5m]))",
          "legendFormat": "conflicts/s",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Outbox depth by status",
      "id": 15,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "payesh_outbox_depth", "legendFormat": "{{status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Auth abuse and rate limiting",
      "id": 16,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(payesh_auth_login_total[5m]))",
          "legendFormat": "login/{{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum by (outcome) (rate(payesh_auth_otp_requests_total[5m]))",
          "legendFormat": "otp/{{outcome}}",
          "refId": "B"
        },
        {
          "expr": "sum by (decision) (rate(payesh_rate_limit_decisions_total[5m]))",
          "legendFormat": "ratelimit/{{decision}}",
          "refId": "C"
        },
        {
          "expr": "sum by (stage) (rate(payesh_auth_rejections_total[5m]))",
          "legendFormat": "enum/{{stage}}",
          "refId": "D"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 },
      "id": 400,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Heap and RSS",
      "id": 17,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "payesh_node_heap_used_bytes", "legendFormat": "heap used", "refId": "A" },
        { "expr": "payesh_node_heap_total_bytes", "legendFormat": "heap total", "refId": "B" },
        { "expr": "payesh_node_rss_bytes", "legendFormat": "rss", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Event-loop lag and CPU",
      "id": 18,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "payesh_node_eventloop_lag_seconds", "legendFormat": "lag", "refId": "A" },
        { "expr": "rate(payesh_node_cpu_seconds_total[5m])", "legendFormat": "cpu {{mode}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "table",
      "title": "Build info / self-monitoring",
      "id": 19,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 65 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "payesh_build_info", "format": "table", "instant": true, "refId": "A" },
        { "expr": "payesh_metrics_dropped_series_total", "format": "table", "instant": true, "refId": "B" },
        { "expr": "payesh_node_uptime_seconds", "format": "table", "instant": true, "refId": "C" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {}
      }
    ]
  }
}
