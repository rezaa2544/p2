# infra/observability/.env.observability — فقط الگو (فایلِ واقعی 0600؛ gitignored با .env*)
GRAFANA_USER=admin
GRAFANA_PASSWORD=
# مسیرِ دایرکتوریِ لاگِ برنامه برای Promtail.
# قرارداد deployment: stdout/stderr برنامه باید به server.log هدایت شود؛ audit.log توسط audit sink نوشته می‌شود.
# در میزبان واقعی معمولاً /var/log/payesh است.
PAYESH_LOG_DIR=
# Owner-provided Alertmanager endpoint. Empty/placeholder values make the
# Alertmanager container refuse to start; never commit the live endpoint.
ALERTMANAGER_WEBHOOK_URL=
