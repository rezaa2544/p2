# ═══════════════════════════════════════════════════════════════════
# سامانه پایش — پیکربندی متغیرهای محیطی (Environment Configuration)
# ═══════════════════════════════════════════════════════════════════

# ── سرور HTTP و پورت‌ها ──────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
PAYESH_ENV=development

# ── پایگاه داده PostgreSQL (فاز ۲) ─────────────────────────────────
# قالب اتصال: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# در صورت خالی بودن، سامانه به‌صورت خودکار در حالت JSON Store اجرا می‌شود
# اتصال مستقیم توسعه:
DATABASE_URL=postgresql://payesh_user:secure_password@localhost:5432/payesh_db
# اتصال تولید از راه PgBouncer (فاز ۲.۳):
# DATABASE_URL=postgresql://payesh_user:secure_password@pgbouncer:6432/payesh_db
PGBOUNCER=0
PGBOUNCER_POOL_MODE=
PG_POOL_MIN=5
PG_POOL_MAX=25
PG_TIMEOUT_MS=3000
PG_IDLE_TIMEOUT_MS=30000

# ── Weighted Partitioning (فاز ۲.۴) ───────────────────────────────
# مدارس شلوغ (پیش‌فرض: ۱۰۰۰+ دانش‌آموز) به شارد/Replica مناسب route می‌شوند
PAYESH_WEIGHTED_PARTITIONING=0
PAYESH_HEAVY_SCHOOL_THRESHOLD=1000
PAYESH_SHARDS=primary-a:1,primary-b:1,primary-c:1,heavy-a:4
DATABASE_READ_REPLICA_URLS=
PG_REPLICA_POOL_MAX=10

# ── ردیس کش و صف (فاز ۴) ──────────────────────────────────────────
# قالب اتصال: redis://[:PASSWORD]@[HOST]:[PORT]/[DB_INDEX]
REDIS_URL=redis://127.0.0.1:6379/0

# ── امنیت و کلیدهای رمزنگاری JWT ──────────────────────────────────
# کلید HS256 با حداقل ۳۲ بایت (۲۵۶ بیت) تصادفی
PAYESH_JWT_SECRET=CHANGE_ME__generate_with_openssl_rand_hex_32
PAYESH_JWT_SECRET_PREV=

# ── WAF (P-WAF): report پیش‌فرض (فقط تشخیص)؛ enforce یعنی بلاک 403 با allowlist (server/waf.js)
PAYESH_WAF_MODE=report

# ── هوک فقط-تست درین (server/index.js): فقط وقتی تنظیم شده مسیر /api/__slow وجود دارد
PAYESH_TEST_SLOW_MS=

# ── کش بیلد کلاینت (build.js): با 1 کش خاموش می‌شود
PAYESH_BUILD_NO_CACHE=

# ── نام قدیمی اتصال در CI: PGURL معادل DATABASE_URL است (هر دو پشتیبانی می‌شوند؛ DATABASE_URL مرجع است)
# PGURL=

# ── پیامک و پنل ورود ──────────────────────────────────────────────
# ارسال کد نمایشی روی API (فقط محیط تست = 1، محیط عملیاتی = 0)
PAYESH_DEMO_CODE=0
PAYESH_SMS_COOLDOWN_S=60
PAYESH_SMS_DAILY_CAP=10
PAYESH_SMS_PHONE_LIMIT=5
PAYESH_SMS_IP_LIMIT=20

# ── مسیرهای داده و لاگ محلی ───────────────────────────────────────
PAYESH_STORE=server/data/payesh.json
PAYESH_AUDIT=server/data/audit.log
PAYESH_KEY=server/data/jwt.key

# ── پشتیبان‌گیری خودکار (میلی‌ثانیه یا ساعت) ───────────────────────
PAYESH_BACKUP_EVERY_HOURS=24

# ── ویو ۱۶ — بازیابی پس از بحران (Disaster Recovery) ───────────────
# کلیدِ رمزنگاریِ پشتیبان (AES-256-GCM). حداقل ۱۶ نویسه.
# در تولید بدونِ این کلید، ساختِ آرشیوِ رمزنگاری‌شده رد می‌شود (fail-closed).
# هرگز کامیت نشود؛ در secret-scan و در لاگِ ممیزی ظاهر نمی‌شود.
# ساخت:  openssl rand -hex 32
PAYESH_BACKUP_KEY=

# مقصدِ کپیِ برون‌سایتی (مسیرِ سوارشدهٔ Object Storage با rclone/s3cmd).
# اگر داخلِ پوشهٔ داده باشد، رد می‌شود — کپی رویِ همان دیسک «برون‌سایتی» نیست.
PAYESH_BACKUP_OFFSITE_DIR=

# اهدافِ RPO/RTO به ثانیه (پیش‌فرض ۳۰۰ / ۹۰۰ مطابقِ docs/RELIABILITY_DR_PLAN.md)
PAYESH_DR_RPO_S=300
PAYESH_DR_RTO_S=900

# ── ویو ۱۴ — پایش‌پذیری (Metrics) ──────────────────────────────────
# 0 = خاموش‌کردنِ کاملِ /metrics (پاسخِ 404)
PAYESH_METRICS=1
# توکنِ Bearer برایِ /metrics. در تولید الزامی است؛ بدونِ آن endpoint وجود ندارد (404).
# ساخت:  openssl rand -hex 32
PAYESH_METRICS_TOKEN=
# سقفِ سریِ برچسب به ازای هر metric (نگهبانِ cardinality)
PAYESH_METRICS_MAX_SERIES=1024
# دورهٔ نمونه‌برداریِ runtime (heap/rss/cpu/event-loop lag) به میلی‌ثانیه
PAYESH_METRICS_INTERVAL_MS=5000
# آستانهٔ «کوئریِ کند» به میلی‌ثانیه
PAYESH_DB_SLOW_MS=250
