# Minimal current-head runtime build context: all paths are denied by default.
**
!package.json
!package-lock.json
!index.html
!USER_GUIDE.html
!account-deletion.html
!privacy.html
!server/
!server/**
!authz/
!authz/write-perms.json
!tools/
!tools/m15-01-route-load.js

# Defense in depth for credentials, local data, ignored datasets, and scratch output.
.env
.env.*
.env*
**/.env
**/.env.*
**/.env*
.npmrc
.gitignore
*.log
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
