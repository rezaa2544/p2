+    var want = SYNC.queue.filter(function(x){ return x.status === 'pending' || x.status === 'failed'; });
+    offlineStorage.getQueue().then(function(have){
+      var wantU = {}; want.forEach(function(x){ wantU[x.uid] = x; });
+      var ops = [];
