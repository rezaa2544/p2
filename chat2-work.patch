+BEGIN;
+DROP INDEX IF EXISTS idx_vclass_sessions_updated_at;
+DROP INDEX IF EXISTS idx_hw_assignments_updated_at;
+DROP INDEX IF EXISTS idx_sync_conflicts_updated_at;
