+/** برچسب فارسی وضعیت دوره */
+function trainingStatusFa(s){
+  for (var i = 0; i < TRAINING_STATUS.length; i++) if (TRAINING_STATUS[i][0] === s) return TRAINING_STATUS[i][1];
