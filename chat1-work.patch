+    const code = W(`(function(){var c=byId('training_courses',${cid});return c.status+':'+staffCertCode(c.id,c.staff_id,c.school_id);})()`);
+    assert(code.indexOf('completed:DOR-') === 0, 'تکمیل از مسیر کلیک نشد: ' + code);
