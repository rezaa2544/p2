+  if (!c) return { ok: false, msg: 'دوره پیدا نشد.' };
+  var want = staffCertCode(c.id, c.staff_id, c.school_id);
+  if (String(code || '').trim().toUpperCase() === want) return { ok: true, msg: 'کدِ گواهی پایان دوره معتبر است' };
