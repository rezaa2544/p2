+    if (!ex){
+      ex = insert('certificates', { school_id: rec.school_id, type: 'staff_training',
+        year: (typeof yearCode === 'function' ? yearCode() : ''), code: code,
+        issued_at: new Date().toISOString(), issued_by: (S.user && S.user.id) || 0 });
