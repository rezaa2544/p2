+/** هستهٔ هش کد احراز (بند B.2: استخراج بدون تغییر رفتار — هم دانش‌آموز هم کادر) */
+function certHash(s, prefix){
   var h = 5381;
   for(var i=0;i<s.length;i++){ h = ((h<<5)+h) ^ s.charCodeAt(i); }
   var A = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
