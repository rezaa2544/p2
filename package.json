{
  "name": "@rezaa2544/payesh",
  "version": "1.0.0",
  "description": "پایش — سامانه هوشمند مدیریت مدرسه (تک‌فایلی، آفلاین، فارسی/RTL)",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "build": "node build.js",
    "build:check": "node build.js --check",
    "dev": "node scripts/dev-server.js",
    "start": "node server/index.js",
    "test": "node tests/run.js && node --expose-gc --max-old-space-size=2048 tests/smoke.js",
    "clean": "rm -rf dist",
    "build:android": "node tools/build-android.js",
    "test:smoke": "node tests/smoke.js",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:create": "node scripts/migrate.js create",
    "scan:secrets": "node tools/secret-scan.js"
  },
  "keywords": [
    "school-management",
    "persian",
    "rtl",
    "jalali",
    "offline-first",
    "single-file"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jsdom": "^30.0.1",
    "node-pg-migrate": "^9.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
