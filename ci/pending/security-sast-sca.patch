From: Payesh Dev <dev@payesh.local>
Date: Wed, 9 Sep 2026 13:17:44 +0000
Subject: [PATCH] =?UTF-8?q?ci(security):=20wave12=20=E2=80=94=20SAST=20(Co?=
 =?UTF-8?q?deQL)=20+=20SCA=20(npm=20audit)=20in=20security=20workflow?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- sast job: CodeQL javascript-typescript analysis on push/PR to main
- sca job: npm audit --omit=dev --audit-level=high (currently 0 findings)
- DAST stays manual for now — checklist documented in the upcoming
  WAVE12_NETWORK_EDGE.md; boot-based tests remain local-only by design
---
 .github/workflows/security.yml | 36 +++++++++++++++++++++++++++++++++-
 1 file changed, 35 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/security.yml b/.github/workflows/security.yml
index 8a240dd..e3eb052 100644
--- a/.github/workflows/security.yml
+++ b/.github/workflows/security.yml
@@ -1,5 +1,7 @@
-# WAF & DDoS Protection — اعتبارسنجیِ امنیتی (P-WAF)
+# اعتبارسنجیِ امنیتی (P-WAF + ویو۱۲: SAST/SCA)
 # - نحویِ nginx + تستِ واحدِ WAF + نشتِ راز
+# - ویو ۱۲: تحلیلِ ایستایِ کد (CodeQL = SAST) + ممیزیِ وابستگی‌ها (npm audit = SCA)
+# - DAST روی نمونهٔ زنده فعلاً دستی است (چک‌لیست در docs/WAVE12_NETWORK_EDGE.md)
 # - نسخهٔ کاملِ tests/waf-ddos.js (بوتِ سرور) به استورِ سیدشده نیاز دارد و
 #   فقط محلی اجرا می‌شود؛ در CI همان --unit-only کافی است.
 name: Security (WAF)
@@ -31,3 +33,35 @@ jobs:
         run: nginx -t -c $PWD/nginx/nginx.conf -p $PWD/nginx/
       - name: Secret scan
         run: node tests/secret-scan.js
+
+  # ── ویو ۱۲: تحلیلِ ایستایِ کد (SAST) با CodeQL ──
+  sast:
+    runs-on: ubuntu-latest
+    permissions:
+      actions: read
+      contents: read
+      security-events: write
+    steps:
+      - uses: actions/checkout@v4
+      - name: Initialize CodeQL
+        uses: github/codeql-action/init@v3
+        with:
+          languages: javascript-typescript
+      - name: Perform CodeQL Analysis
+        uses: github/codeql-action/analyze@v3
+        with:
+          category: "/language:javascript-typescript"
+
+  # ── ویو ۱۲: ممیزیِ وابستگی‌ها (SCA) ──
+  sca:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Use Node.js 22.x
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22.x
+          cache: npm
+      - run: npm ci
+      - name: npm audit (high-and-above only)
+        run: npm audit --omit=dev --audit-level=high
-- 
